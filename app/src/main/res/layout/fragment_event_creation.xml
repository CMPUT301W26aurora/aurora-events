<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/back_button_content_description"
            android:background="@drawable/rounded_box"
            android:backgroundTint="@color/light_glass"
            android:src="@drawable/rounded_arrow_back_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/blue" />

        <TextView
            android:id="@+id/warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:text="@string/required_field_warning_text"
            android:textColor="@color/dark_red"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/addImage"
            android:layout_width="match_parent"
            android:layout_height="189dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/dashed_outer_border"
            android:padding="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/warning">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/dark_inner_bg">

                <ImageView
                    android:id="@+id/iv_event_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/iv_event_image_content_description"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_add_image"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/glass_pill_bg"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="20dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="10dp"
                    android:text="@string/add_an_image_button_text"
                    android:textColor="@color/light_text"
                    android:textSize="14sp"
                    app:icon="@android:drawable/ic_input_add"
                    app:iconGravity="start"
                    app:iconTint="@color/light_text" />
            </FrameLayout>
        </FrameLayout>

        <!-- Event Name Input -->
        <LinearLayout
            android:id="@+id/eventName_input"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/addImage">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/required_event_name_hint"
                android:textColor="@color/purple"
                android:paddingHorizontal="5dp"/>

            <EditText
                android:id="@+id/et_event_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="name"
                android:backgroundTint="@color/blue"
                android:hint="@string/required_event_name_hint"
                android:inputType="text"
                android:textColorHint="@color/light_glass"
                android:textColor="@color/green"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mandatory_label"
                android:textColor="@color/light_glass"
                android:paddingHorizontal="5dp"/>
        </LinearLayout>

        <!-- Event Description Input -->
        <LinearLayout
            android:id="@+id/eventDesc_input"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/eventName_input">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/required_description_hint"
                android:textColor="@color/purple"
                android:paddingHorizontal="5dp"/>

            <EditText
                android:id="@+id/et_event_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="name"
                android:backgroundTint="@color/blue"
                android:hint="@string/required_description_hint"
                android:inputType="text"
                android:textColorHint="@color/light_glass"
                android:textColor="@color/green"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mandatory_label"
                android:textColor="@color/light_glass"
                android:paddingHorizontal="5dp"/>
        </LinearLayout>

        <!-- Event Price Input -->
        <LinearLayout
            android:id="@+id/eventPrice_input"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/eventDesc_input">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/required_price_hint"
                android:textColor="@color/purple"
                android:paddingHorizontal="5dp"/>

            <EditText
                android:id="@+id/et_event_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="name"
                android:backgroundTint="@color/blue"
                android:hint="@string/required_price_hint"
                android:inputType="text"
                android:textColorHint="@color/light_glass"
                android:textColor="@color/green"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mandatory_label"
                android:textColor="@color/light_glass"
                android:paddingHorizontal="5dp"/>
        </LinearLayout>

        <!-- Event Capacity Input -->
        <LinearLayout
            android:id="@+id/eventCapacity_input"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/eventPrice_input">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/required_maximum_participants_hint"
                android:textColor="@color/purple"
                android:paddingHorizontal="5dp"/>

            <EditText
                android:id="@+id/et_event_capacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="name"
                android:backgroundTint="@color/blue"
                android:hint="@string/required_maximum_participants_hint"
                android:inputType="text"
                android:textColorHint="@color/light_glass"
                android:textColor="@color/green"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mandatory_label"
                android:textColor="@color/light_glass"
                android:paddingHorizontal="5dp"/>
        </LinearLayout>

        <!-- Event Capacity Input -->
        <LinearLayout
            android:id="@+id/waitingCapacity_input"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/eventCapacity_input">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/maximum_waiting_list_spots_hint"
                android:textColor="@color/purple"
                android:paddingHorizontal="5dp"/>

            <EditText
                android:id="@+id/et_event_waiting_capacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="name"
                android:backgroundTint="@color/blue"
                android:hint="@string/maximum_waiting_list_spots_hint"
                android:inputType="text"
                android:textColorHint="@color/light_glass"
                android:textColor="@color/green"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/optional_label"
                android:textColor="@color/light_glass"
                android:paddingHorizontal="5dp"/>
        </LinearLayout>

        <!-- Row 1: Select Location + Geolocation Lock -->
        <Button
            android:id="@+id/btn_select_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/glass_pill_bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/required_location_hint"
            android:textColor="@color/light_text"
            android:textSize="13sp"
            app:backgroundTint="@null"
            app:ensureMinTouchTargetSize="false"
            app:icon="@android:drawable/ic_menu_mylocation"
            app:iconGravity="start"
            app:iconTint="@color/purple"
            app:layout_constraintEnd_toStartOf="@+id/btn_geolocation_lock"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/waitingCapacity_input" />

        <Button
            android:id="@+id/btn_geolocation_lock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/glass_pill_bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/geolocation_lock_text"
            android:textColor="@color/light_text"
            android:textSize="13sp"
            app:backgroundTint="@null"
            app:ensureMinTouchTargetSize="false"
            app:icon="@android:drawable/ic_menu_compass"
            app:iconGravity="start"
            app:iconTint="@color/purple"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_select_location"
            app:layout_constraintTop_toBottomOf="@+id/waitingCapacity_input" />

        <!-- Row 2: Sign-Up Start and End -->
        <Button
            android:id="@+id/btn_start_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/glass_pill_bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/required_sign_up_start_hint"
            android:textColor="@color/light_text"
            android:textSize="13sp"
            app:backgroundTint="@null"
            app:ensureMinTouchTargetSize="false"
            app:icon="@android:drawable/ic_menu_today"
            app:iconGravity="start"
            app:iconTint="@color/purple"
            app:layout_constraintEnd_toStartOf="@+id/btn_end_date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_select_location" />

        <Button
            android:id="@+id/btn_end_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/glass_pill_bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/required_sign_up_end_hint"
            android:textColor="@color/light_text"
            android:textSize="13sp"
            app:backgroundTint="@null"
            app:ensureMinTouchTargetSize="false"
            app:icon="@android:drawable/ic_menu_today"
            app:iconGravity="start"
            app:iconTint="@color/purple"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_start_date"
            app:layout_constraintTop_toBottomOf="@+id/btn_select_location" />

        <!-- Row 3: Event Date -->
        <Button
            android:id="@+id/btn_signup_deadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/glass_pill_bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/required_event_date_hint"
            android:textColor="@color/light_text"
            android:textSize="13sp"
            app:backgroundTint="@null"
            app:ensureMinTouchTargetSize="false"
            app:icon="@android:drawable/ic_menu_recent_history"
            app:iconGravity="start"
            app:iconTint="@color/purple"
            app:layout_constraintEnd_toStartOf="@id/btn_is_private"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_start_date" />

        <!-- Row 3: If event is private -->
        <Button
            android:id="@+id/btn_is_private"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/glass_pill_bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/make_private_text"
            android:textColor="@color/light_text"
            android:textSize="13sp"
            app:backgroundTint="@null"
            app:ensureMinTouchTargetSize="false"
            app:icon="@drawable/outline_lock_person_24"
            app:iconGravity="start"
            app:iconTint="@color/purple"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_signup_deadline"
            app:layout_constraintTop_toBottomOf="@+id/btn_start_date" />

        <!-- Confirm Button -->
        <Button
            android:id="@+id/btn_confirm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/gradient_confirm_button"
            android:text="@string/confirm_text"
            android:textColor="@color/dark_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconTint="@color/dark_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_signup_deadline" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>