<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/dialog_background">

    <!-- To: label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/to_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/purple"
        android:layout_marginBottom="10dp"/>

    <!-- Toggles card with aurora gradient background and rounded corners -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/corner_radius"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/background_aroura_gradient"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_participating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/participating_text"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/light_text"
                    android:textSize="15sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_rejected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rejected_text"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/light_text"
                    android:textSize="15sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_invited"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/invited_text"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/light_text"
                    android:textSize="15sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_waiting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/waiting_text"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/light_text"
                    android:textSize="15sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_cancelled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cancelled_text"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/light_text"
                    android:textSize="15sp"/>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Message label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/message_title"
        android:textSize="12sp"
        android:textColor="@color/purple"
        android:layout_marginTop="20dp"/>

    <!-- Message input -->
    <EditText
        android:id="@+id/notification_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="none"
        android:hint="@string/enter_your_message_hint"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:maxLines="4"
        android:background="@null"
        android:textSize="16sp"
        android:textColor="@color/green"
        android:textColorHint="@color/light_glass"
        android:layout_marginTop="4dp"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/blue"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btn_send"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/send_button_text"
        android:textColor="@color/dark_text"
        android:fontFamily="@font/roboto_bold"
        android:stateListAnimator="@null"
        app:icon="@drawable/rounded_check_24"
        app:iconTint="@color/dark_text"
        app:iconGravity="textStart"
        app:backgroundTint="@null"
        android:background="@drawable/gradient_confirm_button"/>

</LinearLayout>