<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#0A1730">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="24dp">

        <!-- back button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/back_button_content_description"
                android:padding="10dp"
                android:src="@drawable/rounded_arrow_back_24"
                app:tint="@color/blue"
                android:background="@drawable/rounded_box"
                android:backgroundTint="@color/light_glass"/>

        </RelativeLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/manage_co_organizers_title"
            android:textSize="14pt"
            android:textColor="@color/blue"
            android:fontFamily="@font/roboto_bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/manage_co_organizers_subtitle"
            android:textSize="6pt"
            android:textColor="@color/light_text"
            android:fontFamily="@font/roboto"/>

        <!-- Add Co-Organizer button - opens a dialog listing eligible entrants -->
        <Button
            android:id="@+id/add_co_organizer_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/green"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/add_co_organizer_button_text"
            android:textColor="@color/dark_text"
            android:fontFamily="@font/roboto_bold"
            app:icon="@drawable/rounded_group_24"
            app:iconTint="@color/dark_text"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/current_co_organizers_label"
            android:textSize="5pt"
            android:textColor="@color/blue"
            android:fontFamily="@font/roboto"/>

        <TextView
            android:id="@+id/empty_co_organizer_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/no_co_organizers_text"
            android:textSize="6pt"
            android:textColor="@color/light_text"
            android:fontFamily="@font/roboto"
            android:background="@drawable/rounded_box"
            android:backgroundTint="@color/light_glass"
            android:visibility="gone"/>

        <ListView
            android:id="@+id/co_organizer_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            android:divider="@color/light_glass"
            android:dividerHeight="1dp"/>

    </LinearLayout>
</ScrollView>
