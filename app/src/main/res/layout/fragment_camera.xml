<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#1C1B2E"
    tools:context=".view.CameraFragment">


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:gravity="center">

        <ImageView
            android:id="@+id/barscanner"
            android:layout_width="177dp"
            android:layout_height="143dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/barscanner_icon_content_description"
            android:scaleType="fitCenter"
            android:src="@drawable/outline_barcode_scanner_24" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/scan"
            android:text="@string/scan_qr_code_button_text"
            android:textColor="@color/dark_text"
            app:icon="@drawable/rounded_photo_camera_24"
            app:iconTint="@color/dark_text"
            app:iconGravity="textStart"
            app:backgroundTint="@null"
            android:background="@drawable/gradient_confirm_button"/>

    </LinearLayout>


</FrameLayout>