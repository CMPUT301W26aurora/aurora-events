<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ListView
        android:id="@+id/notifications_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="96dp"
        android:dividerHeight="8dp"
        android:divider="@android:color/transparent"

        android:clipToPadding="false"
        android:scrollbars="none"/>

    <!-- Opt In (green) — shown when notifications are OFF -->
    <Button
        android:id="@+id/btn_opt_in"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="12dp"
        android:text="@string/opt_in_button_text"
        android:textColor="@color/dark_text"
        android:textSize="14sp"
        android:textStyle="bold"
        app:icon="@drawable/rounded_check_24"
        app:iconTint="@color/dark_text"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:backgroundTint="@color/green"
        android:stateListAnimator="@null"
        app:cornerRadius="24dp"
        android:fontFamily="@font/roboto"/>

    <!-- Opt Out (red) — shown when notifications are ON -->
    <Button
        android:id="@+id/btn_opt_out"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="12dp"
        android:text="@string/opt_out_button_text"
        android:textColor="@color/dark_text"
        android:textSize="14sp"
        android:textStyle="bold"
        app:icon="@drawable/rounded_cancel_24"
        app:iconTint="@color/dark_text"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:backgroundTint="@color/light_red"
        android:stateListAnimator="@null"
        app:cornerRadius="24dp"
        android:fontFamily="@font/roboto"/>

</FrameLayout>