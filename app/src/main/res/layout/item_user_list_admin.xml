<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="18dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/event_list_card">
    <LinearLayout
        android:id="@+id/user_info_list_admin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/user_name_list_admin"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="Name Missing" />
        <TextView
            android:id="@+id/user_email_list_admin"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="No email" />
        <TextView
            android:id="@+id/user_phone_list_admin"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="No Phone" />

        <TextView
            android:id="@+id/user_event_list_own_admin"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="No Events" />

        <TextView
            android:id="@+id/user_event_list_in_admin"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="No Events" />

    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="4dp">

        <ImageButton
            android:id="@+id/delete_user_button_admin_item"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/rounded_delete_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:backgroundTint="@color/zxing_transparent"
            app:tint="@color/dark_red"
            android:contentDescription="Delete User" />
        <ImageButton
            android:id="@+id/show_notif_button_admin_item"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_nav_notifications"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:backgroundTint="@color/zxing_transparent"
            app:tint="@color/black"
            android:contentDescription="Show Notifications" />

    </LinearLayout>
</LinearLayout>